# Copiar a .env y ajustar valores.
# DEBUG=true
# Prefijo REST (debe coincidir con el proxy Vite: rutas /api/...). No dejar API_PREFIX vacío.
# API_PREFIX=/api
# DATABASE_URL=sqlite:///./data/control_accesos.db
# STATE_SAVE_INTERVAL_SECONDS=60
# EVENTS_RETENTION_DAYS=180

# Producción: si el build del frontend está en backend/static (y no en ../frontend/dist):
# STATIC_DIR=./static

# Transporte Modbus:
# - tcp: usa host/port por módulo (panel_modules)
# - rtu: usa bus RS-485 compartido y slave_id por módulo
# MODBUS_MODE=tcp
# MODBUS_TIMEOUT=3
# MODBUS_RETRIES=1
# MODBUS_SERIAL_PORT=COM7
# MODBUS_SERIAL_BAUDRATE=9600
# MODBUS_SERIAL_BYTESIZE=8
# MODBUS_SERIAL_PARITY=N
# MODBUS_SERIAL_STOPBITS=1

# API tablet v1 (JWT). En producción: TABLET_JWT_SECRET largo y aleatorio.
# TABLET_JWT_SECRET=
# TABLET_JWT_EXPIRE_MINUTES=10080
# Si vacío: solo el 1er usuario sin cabecera; más usuarios → definir token y cabecera.
# TABLET_SETUP_TOKEN=

# Panel web (JWT propio). En producción: PANEL_JWT_SECRET largo y aleatorio.
# PANEL_JWT_SECRET=
# PANEL_JWT_EXPIRE_MINUTES=10080
# PANEL_SETUP_TOKEN=

# ETD8A12: al conectar TCP, escribir 0 en relation_register del módulo para desacoplar IN/OUT de fábrica.
# Probar en banco; algunas revisiones cierran el socket. Ver manual (0xFA vs 0x0030 según firmware).
ETD_DISABLE_IN_OUT_ASSOCIATION_ON_CONNECT=true

# Por defecto el backend usa TCP (placas por IP). RS-485 solo si MODBUS_MODE=rtu.
MODBUS_MODE=rtu
MODBUS_TIMEOUT=3
MODBUS_RETRIES=1
# Solo aplican si MODBUS_MODE=rtu (en remoto sin adaptador USB, dejar tcp y omitir COM).
MODBUS_SERIAL_PORT=COM7
MODBUS_SERIAL_BAUDRATE=9600
MODBUS_SERIAL_BYTESIZE=8
MODBUS_SERIAL_PARITY=N
MODBUS_SERIAL_STOPBITS=1