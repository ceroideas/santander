# Copiar a .env y ajustar en producción
COCE_DEBUG=true
COCE_HOST=0.0.0.0
COCE_PORT=9000
COCE_DATABASE_URL=sqlite:///./data/coce.db
COCE_JWT_SECRET=cambiar-en-produccion-coce-jwt
COCE_JWT_EXPIRE_MINUTES=480
# Clave Fernet (32 bytes url-safe base64). Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COCE_SECRETS_KEY=
COCE_SETUP_TOKEN=
COCE_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
